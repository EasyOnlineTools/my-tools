<script>
function calculateDTI() {

    const incomeValue = document.getElementById("income").value.trim();
    const debtValue = document.getElementById("debt").value.trim();

    const error = document.getElementById("error");
    const results = document.getElementById("results");

    error.style.display = "none";
    results.style.display = "none";

    if (incomeValue === "") {
        error.textContent = "Please enter your gross monthly income.";
        error.style.display = "block";
        return;
    }

    if (debtValue === "") {
        error.textContent = "Please enter your total monthly debt payments.";
        error.style.display = "block";
        return;
    }

    const income = Number(incomeValue);
    const debt = Number(debtValue);

    if (!Number.isFinite(income) || income <= 0) {
        error.textContent =
            "Please enter a valid gross monthly income greater than 0.";
        error.style.display = "block";
        return;
    }

    if (!Number.isFinite(debt) || debt < 0) {
        error.textContent =
            "Please enter a valid monthly debt payment amount of 0 or more.";
        error.style.display = "block";
        return;
    }

    if (income > 1000000000000 || debt > 1000000000000) {
        error.textContent =
            "Please enter realistic income and debt amounts.";
        error.style.display = "block";
        return;
    }

    const dti = (debt / income) * 100;

    if (!Number.isFinite(dti)) {
        error.textContent =
            "The calculation could not be completed. Please check your values.";
        error.style.display = "block";
        return;
    }

    const formattedIncome = income.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

    const formattedDebt = debt.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

    const formattedDTI = dti.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

    document.getElementById("incomeResult").textContent =
        "$" + formattedIncome;

    document.getElementById("debtResult").textContent =
        "$" + formattedDebt;

    document.getElementById("dtiResult").textContent =
        formattedDTI + "%";

    document.getElementById("statusResult").textContent =
        formattedDTI + "% of gross income";

    results.style.display = "block";

    if (window.innerWidth <= 700) {
        results.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    }
}

function resetCalculator() {

    document.getElementById("income").value = "";
    document.getElementById("debt").value = "";

    document.getElementById("error").style.display = "none";
    document.getElementById("results").style.display = "none";
}

document.addEventListener("keydown", function(event) {

    if (event.key === "Enter" && event.target.tagName === "INPUT") {
        calculateDTI();
    }

});
</script>

